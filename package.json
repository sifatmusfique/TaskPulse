{
  "name": "taskpulse-js",
  "version": "0.1.0",
  "type": "module",
  "description": "A resilient, persistent, zero-redis background job and workflow queue engine for Node.js / TypeScript",
  "author": "Sifat Musfique",
  "license": "MIT",
  "keywords": [
    "job-queue",
    "background-jobs",
    "sqlite",
    "persistent-queue",
    "worker-pool",
    "cron",
    "typescript",
    "task-runner"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dashboard": {
      "types": "./dist/dashboard/server.d.ts",
      "import": "./dist/dashboard/server.js",
      "require": "./dist/dashboard/server.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sifatmusfique/TaskPulse.git"
  },
  "bugs": {
    "url": "https://github.com/sifatmusfique/TaskPulse/issues"
  },
  "homepage": "https://github.com/sifatmusfique/TaskPulse#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node --import tsx/esm benchmarks/throughput.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
